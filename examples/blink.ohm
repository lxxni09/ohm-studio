ohm: 1
projekt:
  name: Blink – das erste Programm
  beschreibung: Eine LED an Pin 13 blinkt im Sekundentakt. Der Klassiker für den Einstieg.
teile:
  U1: { typ: arduino-uno }
  R1: { typ: widerstand, wert: 220 }
  D1: { typ: led, farbe: rot }
netze:
  LED:  [U1.D13, R1.1]
  LEDA: [R1.2, D1.A]
  GND:  [D1.K, U1.GND]
code:
  ziel: U1
  sprache: arduino
  datei: |
    // Blink: LED an Pin 13 im Sekundentakt
    const int LED = 13;

    void setup() {
      pinMode(LED, OUTPUT);
      Serial.begin(9600);
      Serial.println("Blink gestartet");
    }

    void loop() {
      digitalWrite(LED, HIGH);
      delay(500);
      digitalWrite(LED, LOW);
      delay(500);
    }
test:
  - schritt: Simulation starten
    erwartet: D1 blinkt mindestens 4x innerhalb von 5s
